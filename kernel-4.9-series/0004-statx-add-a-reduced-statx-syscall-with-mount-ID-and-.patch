From d41f996c60edb17024d3035b3ccbe1112e744788 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 28 Oct 2026 16:34:22 +0000
Subject: [PATCH 04/14] statx: add a reduced statx() syscall with mount ID and
 mount root

Kernel 4.9 predates statx() (v4.11) and systemd 258 removed its statx
fallback: stat-util uses statx() everywhere, the mount-point checks in
mount_setup() need STATX_MNT_ID (v5.8) and STATX_ATTR_MOUNT_ROOT (v5.8),
and PID 1 dies with "Failed to determine whether /proc is a mount point"
without them.

The mainline statx commit (a528d35e8bfc) changes the getattr() signature
of every filesystem, 72 files, and Android vendor trees carry their own
filesystems (sdcardfs, esdfs, Samsung's fs changes) that would all need
the same treatment. systemd does not need any of that: it reads the
basic stat fields, the mount ID and the mount-root bit.

So this implements statx() on top of the existing vfs_getattr() path:
STATX_BASIC_STATS (minus atime on MS_NOATIME filesystems, as mainline),
STATX_MNT_ID, STATX_ATTR_MOUNT_ROOT and STATX_ATTR_AUTOMOUNT are
reported; STATX_BTIME and the per-filesystem attribute bits are
reported as unsupported by leaving their mask bits clear, which is
exactly what mainline reports for a filesystem that does not implement
them. The uapi header, the AT_STATX_* flags and the struct layout are
copied from v5.8 unchanged (STATX_ATTR_DAX carries the v5.9 value, v5.8's
collided with STATX_ATTR_MOUNT_ROOT), so a userspace built against
current headers sees the same ABI.

Wired up for the asm-generic table (291, arm64) and the arm64 compat
table (397). x86 and 32-bit ARM are in a separate patch.
---
 arch/arm64/include/asm/unistd32.h |   2 +
 fs/stat.c                         | 130 +++++++++++++++++++++++++++
 include/linux/syscalls.h          |   3 +
 include/uapi/asm-generic/unistd.h |   2 +
 include/uapi/linux/fcntl.h        |   5 ++
 include/uapi/linux/stat.h         | 142 ++++++++++++++++++++++++++++++
 6 files changed, 284 insertions(+)

diff --git a/arch/arm64/include/asm/unistd32.h b/arch/arm64/include/asm/unistd32.h
index 491a1914e83..2b53aae610e 100644
--- a/arch/arm64/include/asm/unistd32.h
+++ b/arch/arm64/include/asm/unistd32.h
@@ -809,6 +809,8 @@ __SYSCALL(__NR_copy_file_range, sys_copy_file_range)
 __SYSCALL(__NR_preadv2, compat_sys_preadv2)
 #define __NR_pwritev2 393
 __SYSCALL(__NR_pwritev2, compat_sys_pwritev2)
+#define __NR_statx 397
+__SYSCALL(__NR_statx, sys_statx)
 #define __NR_pidfd_send_signal 424
 __SYSCALL(__NR_pidfd_send_signal, sys_pidfd_send_signal)
 #define __NR_pidfd_open 434
diff --git a/fs/stat.c b/fs/stat.c
index 068fdbcc9e2..c241d7cbf74 100644
--- a/fs/stat.c
+++ b/fs/stat.c
@@ -18,6 +18,8 @@
 #include <asm/uaccess.h>
 #include <asm/unistd.h>
 
+#include "mount.h"
+
 void generic_fillattr(struct inode *inode, struct kstat *stat)
 {
 	stat->dev = inode->i_sb->s_dev;
@@ -130,6 +132,134 @@ int vfs_lstat(const char __user *name, struct kstat *stat)
 }
 EXPORT_SYMBOL(vfs_lstat);
 
+/*
+ * statx() on this kernel answers from the same ->getattr() path that stat()
+ * uses, so it reports STATX_BASIC_STATS, the mount ID and the mount-root and
+ * automount attributes. STATX_BTIME and the per-filesystem attribute bits are
+ * reported as unsupported (their mask bits stay clear), which is also what a
+ * mainline kernel reports for a filesystem that does not implement them.
+ * Changing every filesystem's getattr signature, as v4.11 did, is not needed
+ * for that.
+ */
+struct kstatx {
+	struct kstat	stat;
+	u32		result_mask;
+	u64		attributes;
+	u64		attributes_mask;
+	u64		mnt_id;
+};
+
+static int vfs_statx(int dfd, const char __user *filename, unsigned int flags,
+		     struct kstatx *sx)
+{
+	struct path path;
+	struct inode *inode;
+	unsigned int lookup_flags = LOOKUP_FOLLOW | LOOKUP_AUTOMOUNT;
+	int error;
+
+	if ((flags & ~(AT_SYMLINK_NOFOLLOW | AT_NO_AUTOMOUNT |
+		       AT_EMPTY_PATH | AT_STATX_SYNC_TYPE)) != 0)
+		return -EINVAL;
+
+	if (flags & AT_SYMLINK_NOFOLLOW)
+		lookup_flags &= ~LOOKUP_FOLLOW;
+	if (flags & AT_NO_AUTOMOUNT)
+		lookup_flags &= ~LOOKUP_AUTOMOUNT;
+	if (flags & AT_EMPTY_PATH)
+		lookup_flags |= LOOKUP_EMPTY;
+retry:
+	error = user_path_at(dfd, filename, lookup_flags, &path);
+	if (error)
+		return error;
+
+	memset(sx, 0, sizeof(*sx));
+	error = vfs_getattr(&path, &sx->stat);
+
+	inode = d_backing_inode(path.dentry);
+	sx->result_mask = STATX_BASIC_STATS | STATX_MNT_ID;
+	/* MS_NOATIME means the filesystem supplies a dummy atime value */
+	if (inode->i_sb->s_flags & MS_NOATIME)
+		sx->result_mask &= ~STATX_ATIME;
+	if (IS_AUTOMOUNT(inode))
+		sx->attributes |= STATX_ATTR_AUTOMOUNT;
+	if (path.mnt->mnt_root == path.dentry)
+		sx->attributes |= STATX_ATTR_MOUNT_ROOT;
+	sx->attributes_mask = STATX_ATTR_AUTOMOUNT | STATX_ATTR_MOUNT_ROOT;
+	sx->mnt_id = real_mount(path.mnt)->mnt_id;
+
+	path_put(&path);
+	if (retry_estale(error, lookup_flags)) {
+		lookup_flags |= LOOKUP_REVAL;
+		goto retry;
+	}
+	return error;
+}
+
+static noinline_for_stack int
+cp_statx(const struct kstatx *sx, struct statx __user *buffer)
+{
+	const struct kstat *stat = &sx->stat;
+	struct statx tmp;
+
+	memset(&tmp, 0, sizeof(tmp));
+
+	tmp.stx_mask = sx->result_mask;
+	tmp.stx_blksize = stat->blksize;
+	tmp.stx_attributes = sx->attributes;
+	tmp.stx_nlink = stat->nlink;
+	tmp.stx_uid = from_kuid_munged(current_user_ns(), stat->uid);
+	tmp.stx_gid = from_kgid_munged(current_user_ns(), stat->gid);
+	tmp.stx_mode = stat->mode;
+	tmp.stx_ino = stat->ino;
+	tmp.stx_size = stat->size;
+	tmp.stx_blocks = stat->blocks;
+	tmp.stx_attributes_mask = sx->attributes_mask;
+	tmp.stx_atime.tv_sec = stat->atime.tv_sec;
+	tmp.stx_atime.tv_nsec = stat->atime.tv_nsec;
+	tmp.stx_ctime.tv_sec = stat->ctime.tv_sec;
+	tmp.stx_ctime.tv_nsec = stat->ctime.tv_nsec;
+	tmp.stx_mtime.tv_sec = stat->mtime.tv_sec;
+	tmp.stx_mtime.tv_nsec = stat->mtime.tv_nsec;
+	tmp.stx_rdev_major = MAJOR(stat->rdev);
+	tmp.stx_rdev_minor = MINOR(stat->rdev);
+	tmp.stx_dev_major = MAJOR(stat->dev);
+	tmp.stx_dev_minor = MINOR(stat->dev);
+	tmp.stx_mnt_id = sx->mnt_id;
+
+	return copy_to_user(buffer, &tmp, sizeof(tmp)) ? -EFAULT : 0;
+}
+
+/**
+ * sys_statx - System call to get enhanced stats
+ * @dfd: Base directory to pathwalk from *or* fd to stat.
+ * @filename: File to stat or "" with AT_EMPTY_PATH
+ * @flags: AT_* flags to control pathwalk.
+ * @mask: Parts of statx struct actually required.
+ * @buffer: Result buffer.
+ *
+ * Note that fstat() can be emulated by setting dfd to the fd of interest,
+ * supplying "" as the filename and setting AT_EMPTY_PATH in the flags.
+ */
+SYSCALL_DEFINE5(statx,
+		int, dfd, const char __user *, filename, unsigned, flags,
+		unsigned int, mask,
+		struct statx __user *, buffer)
+{
+	struct kstatx sx;
+	int error;
+
+	if (mask & STATX__RESERVED)
+		return -EINVAL;
+	if ((flags & AT_STATX_SYNC_TYPE) == AT_STATX_SYNC_TYPE)
+		return -EINVAL;
+
+	error = vfs_statx(dfd, filename, flags, &sx);
+	if (error)
+		return error;
+
+	return cp_statx(&sx, buffer);
+}
+
 
 #ifdef __ARCH_WANT_OLD_STAT
 
